# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# local signing and service configuration
*.keystore
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Local APKs, build verification and signing inputs (never source artifacts)
/build-artifacts/
credentials.json

# ML models are ignored by default to prevent accidental large additions.
# Required runtime models already tracked in Git remain tracked.
assets/ml/*.tflite
assets/ml/*.tar.gz
